#!/bin/bash
set -e

# Create necessary directories
mkdir -p /etc/sins
mkdir -p /var/log/sins
mkdir -p /var/lib/sins

# Set permissions
chown -R sins:sins /var/log/sins /var/lib/sins 2>/dev/null || true
chmod 755 /var/log/sins /var/lib/sins

# Create sins user if it doesn't exist
if ! id -u sins >/dev/null 2>&1; then
    useradd -r -s /bin/false -d /var/lib/sins sins
    chown -R sins:sins /var/log/sins /var/lib/sins
fi

# Copy default configuration if it doesn't exist
if [ ! -f /etc/sins/appsettings.json ]; then
    cp /opt/sins/appsettings.json /etc/sins/appsettings.json
    chown sins:sins /etc/sins/appsettings.json
    chmod 600 /etc/sins/appsettings.json
fi

# Set capabilities for binding to port 53
setcap 'cap_net_bind_service=+ep' /opt/sins/sins || true

# Enable and start systemd service
if [ -f /etc/systemd/system/sins.service ]; then
    systemctl daemon-reload
    systemctl enable sins.service
    echo "SiNS server service enabled. Start it with: systemctl start sins"
else
    echo "Warning: systemd service file not found. Service not enabled."
fi

echo "SiNS server installed successfully!"
echo "Configuration: /etc/sins/appsettings.json"
echo "Logs: /var/log/sins/"
echo "Start service: systemctl start sins"

