{
  "name": "sins-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stack": "concurrently -k -n api,ui -c blue,green \"dotnet run --project ../sins/sins.csproj\" \"vite\"",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tabler/core": "^1.4.0",
    "@tabler/icons-webfont": "^3.41.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "jsdom": "^24.1.3",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
